# Configurações do Ntfy (https://ntfy.sh)
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=thx-notes-1c02de97-9788-4e7d-9de0-d463db50c2a7
NTFY_TOKEN=tk_cg50zt2sueibh16jydupdlxkurd1g

# Banco de Dados Supabase (PostgreSQL)
# DATABASE_URL: URL com Transaction Pooler (porta 6543)
# DIRECT_URL: URL de Conexão Direta (porta 5432)
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Fuso horário padrão para lembretes sem fuso (padrão America/Sao_Paulo)
REMINDER_TZ=America/Sao_Paulo

# Autenticação opcional para a rota MCP
# GATEWAY_AUTH_TOKEN=seu_token_secreto

# Token opcional de proteção para a rota de Cron na Vercel
# CRON_SECRET=seu_cron_secret
