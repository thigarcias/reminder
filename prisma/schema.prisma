generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reminder {
  id                  String   @id @default(uuid())
  message             String
  remindAt            DateTime
  createdAt           DateTime @default(now())
  sent                Boolean  @default(false)
  recorrencia         Int      @default(1)
  recorrenciaIntervalo Int?
  ocorrenciasEnviadas Int      @default(0)

  @@index([sent, remindAt])
}
